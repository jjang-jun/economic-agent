    "home:db:backup-key:init": "node scripts/init-home-backup-key.js",
    "home:db:backup-key:rotate": "node scripts/init-home-backup-key.js --rotate",
    "home:db:backup:verify": "node --env-file-if-exists=.env scripts/verify-home-database-backup.js",
    "home:db:migrate": "node --env-file-if-exists=.env scripts/migrate-database-to-home.js",
    "home:db:sync:dry-run": "node --env-file-if-exists=.env scripts/sync-supabase-to-home.js",
    "home:db:sync:apply": "node --env-file-if-exists=.env scripts/sync-supabase-to-home.js --apply",
    "discord:sync-secret": "node --env-file-if-exists=.env scripts/sync-discord-secret.js",
    "notify:workflow-failure": "node --env-file-if-exists=.env scripts/notify-workflow-failure.js",
    "collector:call": "node --env-file-if-exists=.env scripts/call-news-collector.js",
    "agent:harness-check": "node scripts/agent-harness-check.js",
    "security:audit": "npm audit",
    "db:push": "node --env-file-if-exists=.env scripts/push-supabase.js",
    "db:pull": "node --env-file-if-exists=.env scripts/pull-supabase.js",
    "db:import-local": "node --env-file-if-exists=.env scripts/import-local-history.js",
    "test": "node --test"
