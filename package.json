    "trade:performance": "node --env-file-if-exists=.env scripts/trade-performance.js",
    "cashflow:record": "node --env-file-if-exists=.env scripts/record-portfolio-cash-flow.js",
    "action:report": "node --env-file-if-exists=.env scripts/action-report.js",
    "timing:alert": "node --env-file-if-exists=.env scripts/timing-alert.js",
