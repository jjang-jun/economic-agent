  "keywords": [
    "economic",
    "news",
    "agent",
    "discord",
    "ai",
    "rss"
  ],
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "rss-parser": "^3.13.0"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3",
    "tar": "^7.5.22"
  }
