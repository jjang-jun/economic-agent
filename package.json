    "collector:scheduled": "node --env-file-if-exists=.env scripts/run-scheduled-news-collector.js",
    "collector:ops-report": "node --env-file-if-exists=.env scripts/collector-ops-report.js",
    "price-provider:ops-report": "node --env-file-if-exists=.env scripts/price-provider-ops-report.js",
    "deploy:freshness": "node --env-file-if-exists=.env scripts/deploy-freshness-check.js",
    "digest": "node --env-file-if-exists=.env src/digest.js",
