# AI Provider 설정
# AI_PROVIDER: openai | anthropic | groq | ollama | qwen | deepseek | custom
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
# 작업별 override (선택)
# AI_DIGEST_MODEL=gpt-5.6-terra
# AI_STOCK_MODEL=gpt-5.6-sol
AI_DIGEST_REASONING_EFFORT=low
AI_STOCK_REASONING_EFFORT=medium
AI_DIGEST_VERBOSITY=low
AI_STOCK_VERBOSITY=medium
# Qwen/DeepSeek: enabled | disabled (비용 통제를 위해 기본 disabled)
# AI_DIGEST_THINKING_MODE=disabled
# AI_STOCK_THINKING_MODE=disabled
# AI_TEMPERATURE=0.3       # OpenAI 호환 provider override (선택)
# 개인 식별정보 대신 안정적인 해시/불투명 ID 사용 (선택)
# OPENAI_SAFETY_IDENTIFIER=economic-agent-owner-hash
# AI_BASE_URL=              # 커스텀 엔드포인트 (선택)

# API Keys (사용하는 제공자의 키만 설정)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# DASHSCOPE_API_KEY=your_alibaba_model_studio_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# AI_API_KEY=               # provider별 키가 없을 때 쓰는 범용 fallback

# Discord 리포트·조회·멘션 Agent (docs/DISCORD_SETUP.md)
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
# DISCORD_GUILD_ID=your_discord_server_id_here
# DISCORD_WEBHOOKS_FILE=data/discord-webhooks.json
# DISCORD_REPORTS_ENABLED=true
# Discord 봇 사용을 허용할 사용자 ID. 여러 명은 쉼표로 구분하며 비어 있으면 모두 거부됩니다.
# DISCORD_ALLOWED_USER_IDS=123456789012345678,234567890123456789
# 멘션 요청을 허용할 채널 ID. 설정하면 이 목록 밖의 채널은 거부됩니다.
# DISCORD_ALLOWED_CHANNEL_IDS=345678901234567890
# 봇 계정 대신 같은 이름의 Discord 역할을 멘션할 때 허용할 역할 ID. 여러 개는 쉼표로 구분합니다.
# DISCORD_AGENT_ROLE_IDS=456789012345678901
# PC_WORKER_SHADOW_STARTED_AT=2026-08-05T16:26:00+09:00
# DISCORD_USE_EMBEDS=false
# DISCORD_WEBHOOKS_JSON_BASE64=base64_encoded_channel_webhook_map
# DISCORD_WEBHOOK_OPS=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
DISCORD_REQUEST_TIMEOUT_MS=10000

# 공식 정책 RSS는 일부 기관의 응답 지연/WAF 쿠키 절차를 고려해 별도로 재시도합니다.
# POLICY_SOURCE_TIMEOUT_MS=20000
# POLICY_SOURCE_RETRY_COUNT=2
# POLICY_SOURCE_RETRY_DELAY_MS=750
# POLICY_DETAIL_TIMEOUT_MS=12000    # 알림 후보 공식 상세 페이지 보강 조회
# POLICY_DETAIL_MAX_EVENTS=10       # 한 실행에서 상세 본문을 보강할 최대 알림 수
# OPEN_ASSEMBLY_API_KEY=            # 열린국회정보 별도 인증키(open.assembly.go.kr)
# OPEN_ASSEMBLY_AGE=22              # 현재 국회 대수
# OPEN_ASSEMBLY_BILL_TERMS=         # 선택: 추적 법률명 쉼표 구분
# OPEN_ASSEMBLY_PAGE_SIZE=100
# OPEN_ASSEMBLY_TIMEOUT_MS=15000
# LAW_OPEN_DATA_OC=                # 법제처 국가법령정보 공동활용 승인값(별도 신청)
# LAW_OPEN_DATA_DISPLAY=100
# LAW_OPEN_DATA_TIMEOUT_MS=15000
# PUBLIC_DATA_API_KEY=               # 공공데이터포털 일반 인증키(Decoding); 기존 DATA_GO_KR_API_KEY도 재사용 가능
# REAL_ESTATE_COLLECTION_ENABLED=false
# REAL_ESTATE_REGION_CODES=          # 비우면 서울·경기 전체 시군구
# REAL_ESTATE_RESCAN_MONTHS=2        # 신고 지연·해제 반영을 위해 최근 월 재조회
# REAL_ESTATE_BACKFILL_MONTHS=24     # 최초 1회 수동 백필; 지역별 체크포인트로 재개
# REAL_ESTATE_COLLECTION_CONCURRENCY=4
# REAL_ESTATE_REQUEST_TIMEOUT_MS=20000
# REAL_ESTATE_LISTING_COLLECTION_ENABLED=false # 허가받은 호가 feed가 있을 때만 true
# REAL_ESTATE_LISTING_FEED_URL=                 # HTTPS JSON array 또는 {"listings": []}
# REAL_ESTATE_LISTING_FEED_TOKEN=               # 선택형 Bearer token
# REB_REAL_ESTATE_COLLECTION_ENABLED=false      # R-ONE 인증키 발급 후 true
# REB_OPEN_API_KEY=                             # 한국부동산원 R-ONE 별도 인증키
# REAL_ESTATE_MONITOR_MIN_KRW=580000000
# REAL_ESTATE_MONITOR_MAX_KRW=950000000
# REAL_ESTATE_TARGET_MIN_KRW=850000000
# REAL_ESTATE_TARGET_MAX_KRW=950000000
# REAL_ESTATE_DESIRED_MORTGAGE_KRW=600000000
# REAL_ESTATE_LTV_RATIO=0.70             # 현행 확정값이 아니라 시나리오 가정
# REAL_ESTATE_MORTGAGE_CAP_KRW=600000000 # 현행 확정값이 아니라 시나리오 가정
# REAL_ESTATE_DSR_RATIO=0.40             # 가구 소득·기존부채 입력 전에는 한도 확정 불가
# REAL_ESTATE_STRESS_RATE=0.06
# REAL_ESTATE_MORTGAGE_TERM_YEARS=30
# REAL_ESTATE_POLICY_EFFECTIVE_AT=2026-08-06

# 항상 켜진 PC worker. 최초 72시간은 shadow, 검증 후 active로 전환합니다.
PC_WORKER_SCHEDULER_MODE=shadow
PC_WORKER_PREVENT_SLEEP_ON_AC=false
# PC_WORKER_ID=home-server-01
# PC_WORKER_STATE_FILE=data/pc-worker-state.json
# PC_WORKER_TICK_MS=15000
# PC_WORKER_HEARTBEAT_MS=60000
# PC_WORKER_MAX_CONCURRENT=2
# PC_WORKER_MAX_CATCH_UP_MINUTES=240

# Agent job endpoint
JOB_SECRET=your_job_secret_here
# Browser dashboard. If omitted, JOB_SECRET is used as fallback.
DASHBOARD_SECRET=your_dashboard_secret_here

# 경제지표 API
BOK_API_KEY=your_bok_api_key_here
FRED_API_KEY=your_fred_api_key_here
DART_API_KEY=your_dart_api_key_here

# 홈 서버 PostgreSQL + PostgREST (권장 기준 저장소)
# PostgREST는 127.0.0.1에만 바인딩하며 외부에 공개하지 않습니다.
# DATABASE_REST_URL=http://127.0.0.1:3210
# DATABASE_REST_KEY=                # 로컬 전용 PostgREST에서는 비워 둠
# DATABASE_REST_REQUEST_TIMEOUT_MS=10000
# DATABASE_REST_RETRY_COUNT=1
# DATABASE_REST_RETRY_DELAY_MS=300
# DATABASE_REST_RETRY_MAX_DELAY_MS=5000
# DATABASE_REST_CIRCUIT_BREAKER_MS=60000
# HOME_DB_BACKUP_DIR=data/backups
# openssl rand -base64 32 로 생성. 외부 백업을 암호화할 때 권장합니다.
# HOME_DB_BACKUP_KEY_BASE64=
# 암호화된 .aes 파일만 복제할 별도 디스크/동기화 폴더의 절대 경로
# HOME_DB_OFFSITE_BACKUP_DIR=
# HOME_DB_SCHEDULED_BACKUP_ENABLED=false

# Supabase 전환 호환값. 홈 PostgreSQL 검증/이관이 끝나면 제거합니다.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_REQUEST_TIMEOUT_MS=10000
SUPABASE_RETRY_COUNT=1
SUPABASE_RETRY_DELAY_MS=300
SUPABASE_RETRY_MAX_DELAY_MS=5000
SUPABASE_CIRCUIT_BREAKER_MS=60000
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# SUPABASE_DNS_RESOLVER=https

# 로컬/Actions 포트폴리오
# PORTFOLIO_FILE=data/portfolio.json
PORTFOLIO_JSON_BASE64=

# 한국투자증권 Open API
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_MIN_REQUEST_INTERVAL_MS=1100

# 공식 국내 EOD 가격
KRX_OPENAPI_KEY=your_krx_openapi_key_here
# KRX_OPENAPI_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
# DATA_GO_KR_API_KEY=your_public_data_stock_price_key_here

# Alpaca Market Data
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_DATA_FEED=iex

# Financial Modeling Prep
FMP_BASE_URL=https://financialmodelingprep.com/stable/
FMP_API_KEY=your_fmp_api_key_here
# Optional EOD/global fallbacks
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# TIINGO_TOKEN=your_tiingo_token_here

# 뉴스 수집 정책
MAX_URGENT_ALERTS_PER_RUN=1
MAX_URGENT_ALERTS_PER_DAY=2
URGENT_EVENT_DEDUP_HOURS=24
IMMEDIATE_ALERT_MIN_IMPORTANCE=5
IMMEDIATE_ALERT_MIN_URGENCY=4.5
NEWS_COLLECTOR_LOOKBACK_MINUTES=30
NEWS_COLLECTOR_MAX_LOOKBACK_MINUTES=240
NEWS_COLLECTOR_LOOKBACK_BUFFER_MINUTES=10
STALE_IMMEDIATE_ALERT_MINUTES=30

# 가격·거래량 이상징후와 기사/공시의 선후관계 검증 범위
PRE_NEWS_EVIDENCE_LOOKBACK_HOURS=12
PRE_NEWS_FOLLOW_UP_HOURS=24

# KOSPI/KOSDAQ 장중 급락 단계별 경보
MARKET_STRESS_ALERTS_ENABLED=true
MARKET_STRESS_WARNING_PCT=-3
MARKET_STRESS_SEVERE_PCT=-5
MARKET_STRESS_CIRCUIT_BREAKER_PCT=-8

# 성과 학습 준비도. 승인 후보의 고정 20거래일 평가 표본에 적용
STRATEGY_MIN_EVALUATED=30
STRATEGY_MIN_LINKED_TRADES=10
# 정확한 EOD를 못 구한 경우 현재가 대체는 기본 금지
EVALUATION_ALLOW_CURRENT_FALLBACK=false

# Cloud Run/low-memory collector에서는 FinBERT 비활성화를 권장
DISABLE_FINBERT=1
