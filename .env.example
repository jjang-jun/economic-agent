# AI Provider 설정
# AI_PROVIDER: openai | anthropic | groq | ollama | qwen | deepseek | custom
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
# 작업별 override (선택)
# AI_DIGEST_MODEL=gpt-5.6-terra
# AI_STOCK_MODEL=gpt-5.6-sol
AI_DIGEST_REASONING_EFFORT=low
AI_STOCK_REASONING_EFFORT=medium
AI_DIGEST_VERBOSITY=low
AI_STOCK_VERBOSITY=medium
# Qwen/DeepSeek: enabled | disabled (비용 통제를 위해 기본 disabled)
# AI_DIGEST_THINKING_MODE=disabled
# AI_STOCK_THINKING_MODE=disabled
# AI_TEMPERATURE=0.3       # OpenAI 호환 provider override (선택)
# 개인 식별정보 대신 안정적인 해시/불투명 ID 사용 (선택)
# OPENAI_SAFETY_IDENTIFIER=economic-agent-owner-hash
# AI_BASE_URL=              # 커스텀 엔드포인트 (선택)

# API Keys (사용하는 제공자의 키만 설정)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# DASHSCOPE_API_KEY=your_alibaba_model_studio_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# AI_API_KEY=               # provider별 키가 없을 때 쓰는 범용 fallback

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 공유 뉴스/시장 브리핑 방
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# 포트폴리오/거래/경제적 자유/대화형 Agent 전용 비공개 방
TELEGRAM_SECRET_CHAT_ID=your_private_telegram_chat_id_here
# TELEGRAM_PRIVATE_CHAT_ID=your_private_telegram_chat_id_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_REQUEST_TIMEOUT_MS=10000

# Agent job endpoint
JOB_SECRET=your_job_secret_here
# Browser dashboard. If omitted, JOB_SECRET is used as fallback.
DASHBOARD_SECRET=your_dashboard_secret_here

# 경제지표 API
BOK_API_KEY=your_bok_api_key_here
FRED_API_KEY=your_fred_api_key_here
DART_API_KEY=your_dart_api_key_here

# Supabase 히스토리 저장소
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_REQUEST_TIMEOUT_MS=10000
SUPABASE_RETRY_COUNT=1
SUPABASE_RETRY_DELAY_MS=300
SUPABASE_RETRY_MAX_DELAY_MS=5000
SUPABASE_CIRCUIT_BREAKER_MS=60000
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# SUPABASE_DNS_RESOLVER=https

# 로컬/Actions 포트폴리오
# PORTFOLIO_FILE=data/portfolio.json
PORTFOLIO_JSON_BASE64=

# 한국투자증권 Open API
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_MIN_REQUEST_INTERVAL_MS=1100

# 공식 국내 EOD 가격
KRX_OPENAPI_KEY=your_krx_openapi_key_here
# KRX_OPENAPI_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
# DATA_GO_KR_API_KEY=your_public_data_stock_price_key_here

# Alpaca Market Data
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_DATA_FEED=iex

# Financial Modeling Prep
FMP_BASE_URL=https://financialmodelingprep.com/stable/
FMP_API_KEY=your_fmp_api_key_here
# Optional EOD/global fallbacks
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# TIINGO_TOKEN=your_tiingo_token_here

# 뉴스 수집 정책
MAX_URGENT_ALERTS_PER_RUN=1
MAX_URGENT_ALERTS_PER_DAY=2
URGENT_EVENT_DEDUP_HOURS=24
IMMEDIATE_ALERT_MIN_IMPORTANCE=5
IMMEDIATE_ALERT_MIN_URGENCY=4.5
NEWS_COLLECTOR_LOOKBACK_MINUTES=30
NEWS_COLLECTOR_MAX_LOOKBACK_MINUTES=240
NEWS_COLLECTOR_LOOKBACK_BUFFER_MINUTES=10
STALE_IMMEDIATE_ALERT_MINUTES=30

# 가격·거래량 이상징후와 기사/공시의 선후관계 검증 범위
PRE_NEWS_EVIDENCE_LOOKBACK_HOURS=12
PRE_NEWS_FOLLOW_UP_HOURS=24

# KOSPI/KOSDAQ 장중 급락 단계별 경보
MARKET_STRESS_ALERTS_ENABLED=true
MARKET_STRESS_WARNING_PCT=-3
MARKET_STRESS_SEVERE_PCT=-5
MARKET_STRESS_CIRCUIT_BREAKER_PCT=-8

# 성과 학습 준비도. 승인 후보의 고정 20거래일 평가 표본에 적용
STRATEGY_MIN_EVALUATED=30
STRATEGY_MIN_LINKED_TRADES=10
# 정확한 EOD를 못 구한 경우 현재가 대체는 기본 금지
EVALUATION_ALLOW_CURRENT_FALLBACK=false

# Cloud Run/low-memory collector에서는 FinBERT 비활성화를 권장
DISABLE_FINBERT=1
